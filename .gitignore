# AI Tutor - Root .gitignore

# ── Common ────────────────────────────────────────────────────────────────────
node_modules/
.DS_Store
Thumbs.db
*.pem

# Environment files (chứa secrets, không bao giờ commit)
.env
.env.*
.env.local
.env.*.local
!.env.example

# IDE & Editor
.idea/
.vscode/
*.swp
*.swo
*~

# AI Agents & Editors
.cursorrules
.aichat/
.anthropic/
.claude/
*.agents
!ai-tutor-frontend/.agents/
!ai-tutor-frontend/.agents/**
**/AGENTS.md
**/CLAUDE.md

# ── Frontend (ai-tutor-frontend) ──────────────────────────────────────────────
ai-tutor-frontend/node_modules/
ai-tutor-frontend/.next/
ai-tutor-frontend/out/
ai-tutor-frontend/build/
ai-tutor-frontend/dist/
ai-tutor-frontend/npm-debug.log*
ai-tutor-frontend/next-env.d.ts
ai-tutor-frontend/*.tsbuildinfo

# ── Backend (ai-tutor-backend) ────────────────────────────────────────────────
ai-tutor-backend/node_modules/
ai-tutor-backend/__pycache__/
ai-tutor-backend/.venv/
ai-tutor-backend/venv/
ai-tutor-backend/*.pyc

# Uploaded documents & processed storage
ai-tutor-backend/storage/

# ── ChromaDB (vector database) ────────────────────────────────────────────────
**/chroma_db/
**/chroma_data/
**/chroma-data/
**/.chroma/

# ── Storage & Runtime data ────────────────────────────────────────────────────
**/storage/uploads/
**/storage/mongo_data/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ── SSL & Secrets ─────────────────────────────────────────────────────────────
nginx/ssl/
*.key
*.crt
*.cert

# ── Docker ────────────────────────────────────────────────────────────────────
.docker/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Desktop.ini

# ── Skill & local design context ─────────────────────────────────────────────
**/.agents/
**/.agent/
.impeccable/
PRODUCT.md
DESIGN.md
**/PRODUCT.md
**/DESIGN.md
COMMIT_CONVENTION.md
**/.codex-vite.log
**/docs/

skills-lock.json
start-chrome-debug.bat
