# Dockerfile.dev — Backend dev mode (nodemon auto-reload)
FROM node:20-alpine

# LibreOffice headless for DOCX → PDF conversion (accurate page numbers)
# font-liberation: metrically compatible with Times New Roman, Arial, Courier New
# font-carlito: metrically compatible with Calibri (default Word font since 2007)
# font-noto: fallback for Vietnamese and Unicode characters
RUN apk add --no-cache libreoffice-writer \
    font-noto font-liberation font-carlito fontconfig \
    && fc-cache -f

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

RUN mkdir -p ./storage/uploads

EXPOSE 8081

# Dùng nodemon để auto-reload khi code thay đổi
CMD ["npx", "nodemon", "src/server.js"]
