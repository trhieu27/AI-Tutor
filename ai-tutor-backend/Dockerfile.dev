# Dockerfile.dev — Backend dev mode (nodemon auto-reload)
FROM node:20-alpine

# LibreOffice headless for DOCX → PDF conversion (accurate page numbers)
RUN apk add --no-cache libreoffice-writer font-noto

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

RUN mkdir -p ./storage/uploads

EXPOSE 8081

# Dùng nodemon để auto-reload khi code thay đổi
CMD ["npx", "nodemon", "src/server.js"]
